{
  "$comment": "opc-agent 硬规则的唯一来源。本地钩子（CodeBuddy / Cursor）和 CI 必需检查都读这一份。改它需要你本人批准（Agent 改它会被拦）。",
  "planGate": "on",
  "codePaths": [
    "apps/**",
    "packages/**",
    "packs/**",
    "mcp/**"
  ],
  "protectedPaths": [
    "policy/**",
    "scripts/hooks/**",
    "scripts/lib/**",
    "scripts/checks/**",
    "scripts/ci/**",
    ".github/workflows/**",
    ".github/prompts/**",
    ".codebuddy/settings.json",
    ".cursor/hooks.json",
    "evals/agent/**"
  ],
  "secretPaths": [
    ".env",
    ".env.*",
    "**/.env",
    "**/.env.*",
    "secrets/**",
    "**/*.pem",
    "**/*.key",
    "**/id_rsa*",
    "**/id_ed25519*",
    ".opc/credentials*",
    ".opc/settings*.json"
  ],
  "testPaths": [
    "**/*.test.ts",
    "**/*.test.js",
    "**/*.spec.ts",
    "tests/**",
    "**/__tests__/**",
    "evals/product/golden/**"
  ],
  "laneDPaths": [
    "packs/legal/**",
    "packs/finance/**",
    "packs/registration/**",
    "packages/core/src/security/**"
  ],
  "maxAgentsMdLines": 150,
  "shell": {
    "deny": [
      {
        "re": "(^|[\\s;&|(])(npm|pnpm|yarn|bun)\\s+(run(-script)?\\s+)?(-\\S+\\s+)*approve(\\s|$|[;&|)])",
        "why": "批准计划（G2）只能由你本人在自己的终端执行"
      },
      {
        "re": "(^|[\\s;&|(])(node|bun|deno(\\s+run)?|tsx|ts-node|npx|(ba|z|da)?sh|source|\\.)\\s+(-\\S+\\s+)*[^\\s;&|]*scripts/ci/approve\\.mjs|(^|[;&|(\\n])\\s*[^\\s;&|]*scripts/ci/approve\\.mjs",
        "why": "批准计划（G2）只能由你本人在自己的终端执行（查看脚本源码不受限）"
      },
      {
        "re": "^(?=[\\s\\S]*approved)[\\s\\S]*(>|\\btee\\s+(-\\S+\\s+)*)\\s*[\"']?[^\\s;&|\"'<>]*docs/plans/",
        "why": "计划的 approved 只能由你本人用 npm run approve 写入（G2）"
      },
      {
        "re": "^(?=[\\s\\S]*approved)[\\s\\S]*\\b(sed|perl)\\b[^;&|\\n]*\\s(-[a-z]*i|--in-place)[^;&|\\n]*docs/plans/",
        "why": "计划的 approved 只能由你本人用 npm run approve 写入（G2）"
      },
      {
        "re": "^(?=[\\s\\S]*approved)[\\s\\S]*\\b(cp|mv|install|rsync|ln)\\s[^;&|\\n]*\\s[\"']?[^\\s;&|\"']*docs/plans/[^\\s;&|\"']*[\"']?\\s*($|[;&|\\n])",
        "why": "计划的 approved 只能由你本人用 npm run approve 写入（G2）"
      },
      {
        "re": "^(?=[\\s\\S]*approved)[\\s\\S]*(^|[\\s;&|(])(node|python[0-9.]*|perl|ruby|deno|bun|php)\\s[\\s\\S]*docs/plans/",
        "why": "计划的 approved 只能由你本人用 npm run approve 写入（G2）"
      },
      {
        "re": "rm\\s+-[a-zA-Z]*r[a-zA-Z]*f?\\s+(/|~|\\$HOME)(\\s|$)",
        "why": "禁止删除根目录或家目录"
      },
      {
        "re": "git\\s+push\\s+.*(--force|-f)(\\s|$).*\\b(main|master)\\b",
        "why": "禁止强推主分支"
      },
      {
        "re": "(^|[\\s;&|(])git(\\s+(-[cC]\\s+\\S+|--[\\w-]+(=\\S+)?))*\\s+push\\b[^;&|\\n]*((\\s|:|\\+|[\"']|refs/heads/)(main|master)([\"']|\\s|[;&|)]|$)|\\s--(all|mirror)\\b)",
        "why": "主分支只能通过 PR 合并，不能直接推"
      },
      {
        "re": "gh\\s+pr\\s+merge",
        "why": "合并是 G3 关口，只能由你本人点"
      },
      {
        "re": "gh\\s+api\\b[\\s\\S]*\\b(mergePullRequest|enablePullRequestAutoMerge|mergeBranch)\\b",
        "why": "合并是 G3 关口，只能由你本人点"
      },
      {
        "re": "gh\\s+release\\s+create|npm\\s+publish|pnpm\\s+publish",
        "why": "发布只走 release 工作流（有人工审批）"
      },
      {
        "re": "(curl|wget)[^|]*\\|\\s*(ba|z)?sh",
        "why": "禁止下载即执行"
      },
      {
        "re": "(cat|less|more|head|tail|type)\\s+[^|;]*\\.env(\\.|\\s|$)",
        "why": "禁止读取密钥文件"
      },
      {
        "re": "printenv|env\\s*$|echo\\s+\\$\\{?[A-Z_]*(KEY|TOKEN|SECRET)",
        "why": "禁止打印环境变量里的密钥"
      },
      {
        "re": "gh\\s+auth\\s+(token|git-credential)\\b|gh\\s+auth\\s+status\\b[^;&|\\n]*\\s(--show-token|-t)(\\s|=|$)|git\\s+credential(-[\\w-]+)?\\s+(fill|get)\\b",
        "why": "禁止打印 gh / git 的登录凭据"
      },
      {
        "re": "\\.config/gh(/|\\s|[\"']|$)",
        "why": "禁止读取 gh 配置目录（里面有登录令牌）"
      },
      {
        "re": "git\\s+(commit|push).*--no-verify",
        "why": "禁止跳过钩子"
      },
      {
        "re": "gh\\s+api\\s+.*(/merge|/merges)",
        "why": "合并是 G3 关口，只能由你本人点"
      },
      {
        "re": "gh\\s+api\\b[\\s\\S]*\\b(create|update|delete)(BranchProtectionRule|RepositoryRuleset)\\b",
        "why": "分支保护和 rulesets 只能由你本人改（读取不受限）"
      },
      {
        "re": "gh\\s+api\\b(?=[^;&|\\n]*/(protection|rulesets)\\b)(?=[^;&|\\n]*(\\s(-X\\s*|--method[\\s=]+)[\"']?(POST|PUT|PATCH|DELETE)\\b|\\s(-f|-F|--field|--raw-field|--input)[\\s=]))",
        "why": "分支保护和 rulesets 只能由你本人改（读取不受限）"
      },
      {
        "re": "((^|[;&|(\\n])\\s*|(^|[\\s;&|(])((ba|z|da)?sh|source|\\.)\\s+(-\\S+\\s+)*)[^\\s;&|]*scripts/ci/setup-github\\.sh",
        "why": "setup-github.sh 会改仓库设置（分支保护、标签），只能由你本人执行（查看源码不受限）"
      },
      {
        "re": "gh\\s+(pr|issue)\\s+(create|edit)\\b[^;&|\\n]*\\s(--label|--add-label|--remove-label|-l)(\\s+|=)(\"[^\"]*|'[^']*|[^\\s\"';&|]*)(guardrail-ok|agent/build)",
        "why": "guardrail-ok / agent/build 标签只能由你本人加"
      },
      {
        "re": "gh\\s+api\\b(?=[^;&|\\n]*/labels\\b)(?=[^;&|\\n]*(\\s(-X\\s*|--method[\\s=]+)[\"']?(POST|PUT|PATCH|DELETE)\\b|\\s(-f|-F|--field|--raw-field|--input)[\\s=]))",
        "why": "guardrail-ok / agent/build 标签只能由你本人加；用 gh api 改标签一律拦，加普通标签请用 gh pr edit --add-label"
      },
      {
        "re": "gh\\s+api\\b[\\s\\S]*\\b(addLabelsToLabelable|removeLabelsFromLabelable|createLabel|updateLabel|deleteLabel|labelIds)\\b",
        "why": "guardrail-ok / agent/build 标签只能由你本人加；用 GraphQL 改标签一律拦"
      },
      {
        "re": "gh\\s+label\\s+(clone\\b|(create|edit|delete)\\b[^;&|\\n]*(guardrail-ok|agent/build))",
        "why": "guardrail-ok / agent/build 标签只能由你本人加"
      },
      {
        "re": "(^|[\\s;&|(])(sudo|doas|pkexec)(\\s|$)",
        "why": "禁止提权执行命令"
      }
    ],
    "ask": [
      {
        "re": "git\\s+push",
        "why": "推送到远端前确认一下"
      },
      {
        "re": "(npm|pnpm|yarn)\\s+(add|install|i)\\s+[^-]",
        "why": "新增依赖要确认（供应链风险）"
      },
      {
        "re": "git\\s+reset\\s+--hard|git\\s+clean\\s+-[a-z]*f",
        "why": "会丢弃改动"
      }
    ]
  },
  "owners": [
    "andrewlayuan"
  ],
  "laneA": {
    "maxChangedLines": 80,
    "kinds": [
      "fix",
      "chore"
    ]
  }
}
